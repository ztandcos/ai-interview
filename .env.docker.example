# Docker Compose 本地环境。复制成 .env 前请按需修改密码。
DOCKER_MYSQL_ROOT_PASSWORD=local-root-password
DOCKER_MYSQL_PASSWORD=local-app-password
MYSQL_EXPOSE_PORT=3307
REDIS_EXPOSE_PORT=6380
BACKEND_EXPOSE_PORT=8006
FRONTEND_EXPOSE_PORT=8080

JWT_SECRET_KEY=replace-with-a-long-random-secret
EXPOSE_VERIFICATION_CODE=true

# 默认 mock 不需要联网；可改为 deepseek 或 ollama。
LLM_PROVIDER=mock
LLM_MODEL_NAME=deepseek-chat
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_FALLBACK_TO_MOCK=true

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL_NAME=qwen2.5:3b
